# Copie para .env.local e use a URL e a chave pública do projeto Supabase.
# A chave publishable é própria para navegador; nunca use service_role ou sb_secret_ aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Browser Maps key: restrict to the production website and Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=
# Optional custom vector map ID. DEMO_MAP_ID is used for initial development.
VITE_GOOGLE_MAPS_MAP_ID=
